# ---- Database (recommended) ----
# Free Postgres from https://neon.tech — one connection string works for both
# local dev and Vercel. Enables: persistence, multi-bank, fast incremental sync.
# After setting: npm run db:push   (creates the tables)
# Without it, the app falls back to the file/env token storage.
# DATABASE_URL=

# ---- Plaid (https://dashboard.plaid.com) ----
# Products used: Transactions (banks) + Investments (holdings/securities).
# In the Plaid Dashboard, enable both products. Transactions alone cannot
# return brokerage holdings — that requires /investments/holdings/get.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# sandbox: Investments works without extra permissions. Use Plaid's published
# sandbox credentials from https://plaid.com/docs/sandbox/ (do not invent them).
# production: request Investments + OAuth institution access. Fidelity production
# access is typically automatic on Growth/Custom plans ~8 weeks after Production
# is granted (Pay-as-you-go must request it). Schwab OAuth can take up to six weeks.
# Institution IDs are resolved at Link time via /institutions/search — do not hardcode.

# Production only: OAuth banks (Chase, BofA, Fidelity, Schwab...) require a
# redirect URI that is ALSO registered in the Plaid dashboard
# (Developers -> API -> Allowed redirect URIs).
# Local linking:    http://localhost:3000/settings
# Deployed linking: https://your-app.vercel.app/settings
# PLAID_REDIRECT_URI=

# For serverless deploys (Vercel): after linking locally, copy the access token
# from .plaid-store.json into this var (no persistent disk there). Supports a
# single Item only — use DATABASE_URL for multiple banks/brokerages.
# PLAID_ACCESS_TOKEN=

# ---- Weekly digest email (Sundays via Vercel Cron) ----
# Option A (recommended): Resend — free key at https://resend.com/api-keys
# RESEND_API_KEY=
# DIGEST_TO=you@yourdomain.com
# Optional custom sender; free tier without a verified domain uses onboarding@resend.dev
# EMAIL_FROM=

# Option B: Gmail/Google Workspace SMTP (used only if RESEND_API_KEY is unset)
# GMAIL_USER=you@yourdomain.com
# App password: Google Account -> Security -> 2-Step Verification -> App passwords
# GMAIL_APP_PASSWORD=

# ---- AI features (Assistant page + auto-categorization) ----
# Get a key at https://console.anthropic.com -> API keys. Costs pennies/month at
# personal scale (uses a small fast model; override with AI_MODEL if desired).
# ANTHROPIC_API_KEY=

# ---- Deployment security ----
# Encrypts Plaid access tokens at rest in the database (AES-256-GCM).
# Generate with: openssl rand -hex 32  — set the SAME key locally and on Vercel.
# Existing plaintext tokens are migrated automatically on the next sync.
# ENCRYPTION_KEY=

# Password gate for the whole app (leave unset for open local dev)
# APP_PASSWORD=
# Protects /api/digest; Vercel Cron sends it automatically as a Bearer token
# CRON_SECRET=
